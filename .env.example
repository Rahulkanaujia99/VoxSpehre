# ==============================================================================
# VoxSphere AI Enterprise Preconfigured API Credentials
# ==============================================================================
# All API keys are stored exclusively on the server and used by backend routes.
# Never exposed to frontend JavaScript, local storage, or browser networks.
#
# IMPORTANT: Put your real keys in `.env.local`. Do not commit `.env.local` to Git.

# 1. Sarvam AI API Key (Default Speech-to-Text Engine)
# Used for Saaras v4 multilingual audio transcription with timestamps
# Obtain from Sarvam AI: https://www.sarvam.ai/
SARVAM_API_KEY=

# 2. Google Gemini API Key
# Used for multimodal AI speech recognition and executive summarization
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAI API Key
# Used for Whisper-1 speech-to-text and AI text intelligence / summarization
# Obtain from OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Tavily API Key
# Used for real-time web search, topic intelligence enrichment, and fact citations
# Obtain from Tavily AI: https://app.tavily.com/
TAVILY_API_KEY=

# 4. Groq API Key (Optional)
# Used for ultra-fast whisper-large-v3-turbo inference
# Obtain from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=

# ==============================================================================
# Supabase Backend Configuration (Database, Storage & Authentication)
# ==============================================================================
# Obtain from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service Role Key for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=
