# Optional Server-Side API Keys for Vercel Deployment
# If set in Vercel Environment Variables, all visitors can transcribe without entering their own keys.
# If omitted, visitors can enter their own API key directly in the web app UI.

# Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# Groq Whisper (Fast & free tier available at https://console.groq.com)
GROQ_API_KEY=

# OpenAI Whisper (Paid tier at https://platform.openai.com)
OPENAI_API_KEY=
